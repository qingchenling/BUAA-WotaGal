## 主菜单 - 整体容器
style mainMenu_vbox:
    xalign 0.5
    yalign 0.5
    spacing 20

## 主菜单 - 标题
style mainMenu_title:
    size 80
    textalign 0.5
    xalign 0.5
    color "#ffffff"

## 主菜单 - 按钮
style mainMenu_button:
    xalign 0.5
    size_group "mainMenu"

style mainMenu_button_text:
    size 36
    color "#ffffff"
    hover_color "#ffcc00"
