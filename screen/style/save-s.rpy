## 存档 / 读档共用样式
## ============================================================

## 存档页标题按钮
style slot_page_label:
    xsize 300
    ysize 46
    background "#33333388"
    padding (10, 10)

style slot_page_label_text:
    color "#ffffff"
    size 24
    textalign 0.5
    xalign 0.5

## 存档槽位按钮
style slot_button:
    xsize 340
    ysize 220
    background "#33333388"
    hover_background "#55555588"
    padding (12, 12)

## 槽位 - 截图（由 FileScreenshot 自动填充）

## 槽位 - 时间文字
style slot_time_text:
    color "#aaaaaa"
    size 18
    textalign 0.5
    xalign 0.5

## 槽位 - 存档名称
style slot_name_text:
    color "#ffffff"
    size 22
    textalign 0.5
    xalign 0.5

## 翻页按钮
style slot_page_button:
    background None
    padding (10, 8)

style slot_page_button_text:
    color "#999999"
    size 22
    hover_color "#ffffff"
    selected_color "#ffcc00"
