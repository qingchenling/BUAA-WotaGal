## 对话框 - 底部窗口
style say_window:
    xfill True
    ysize 240
    yalign 1.0
    background "#000000cc"
    padding (60, 30)

## 对话框 - 内部文本
style say_dialogue:
    color "#ffffff"
    size 28
    line_spacing 8
    line_leading 6

## 姓名框
style say_namebox:
    background "#444444cc"
    xsize 260
    ysize 52
    padding (20, 10)
    xpos 60
    ypos -30

## 姓名框文字
style say_namebox_text:
    size 26
    color "#ffffff"
    xalign 0.5
    yalign 0.5
