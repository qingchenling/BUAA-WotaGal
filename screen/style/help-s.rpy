## ============================================================
## 帮助 / 关于界面样式
## ============================================================

## 帮助 - 游戏标题
style help_title:
    color "#ffffff"
    size 52
    bold True
    textalign 0.5
    xfill True

## 帮助 - 副标题（英文名 + 版本号）
style help_subtitle:
    color "#aaaaaa"
    size 24
    textalign 0.5
    xfill True

## 帮助 - 正文段落
style help_body:
    color "#cccccc"
    size 26
    textalign 0.0
    line_spacing 10
    line_leading 8
    xfill True

## 帮助 - 段落标题（故事背景 / 操作方法）
style help_section:
    color "#ffcc00"
    size 30
    bold True
    textalign 0.0
    xfill True

## 帮助 - 页脚
style help_footer:
    color "#888888"
    size 22
    textalign 0.5
    xfill True
